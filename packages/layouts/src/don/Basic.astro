---
import { Container } from "@developer-overheid-nl/don-register-components";
import Base from "./Base.astro";

const { appConfig, titlePage, description } = Astro.props;
---

<Base titlePage={titlePage} description={description} appConfig={appConfig}>
  <slot name="head" slot="head" />
  <slot name="body-start" slot="body-start" />
  <Container>
    <div class="basic-content">
      <slot />
    </div>
  </Container>
  <slot name="body-end" slot="body-end" />
</Base>
