{
  "extends": "astro/tsconfigs/strict",
  "include": [".storybook/**/*", "cypress/**/*", "types/**/*", "*.ts"],
  "exclude": ["apps", "packages", "proprietary-*", "**/dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true
  }
}
