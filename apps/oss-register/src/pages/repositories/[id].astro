---
export const prerender = false; // Not needed in 'server' mode

import {
  API_ENDPOINT,
  API_URL,
  API_VERSION,
  API_X_API_KEY,
  PIWIK_PRO_ACCOUNT_ADDRESS,
  PIWIK_PRO_SITE_ID,
} from "astro:env/server";
import {
  AccordionProvider,
  Alert,
  AlignBox,
  Block,
  ButtonAction,
  ButtonLink,
  DataBadge,
  type DataBadgeAppearance,
  DataList,
  DataListActions,
  DataListItem,
  DataListKey,
  DataListValue,
  DataSummary,
  DataSummaryItem,
  Heading,
  HeadingGroup,
  Icon,
  Link,
  LinkButton,
  Markdown,
  Paragraph,
  PillBadge,
} from "@developer-overheid-nl/don-register-components";
import { PiwikPro } from "@developer-overheid-nl/don-register-components/analytics";
import i18n from "@developer-overheid-nl/don-register-components/i18n";
import {
  DonBasic,
  DonDetail,
} from "@developer-overheid-nl/don-register-layouts";
import createClient from "openapi-fetch";
import appConfig from "../../../app.config";
import { ProjectsAccordion } from "../../components/ProjectsAccordion";
import RepoIcon from "../../components/RepoIcon.astro";
import { ApiPaths, type paths } from "../../types/api-schema";

const { id = "" } = Astro.params;
const API_RESOURCE = ApiPaths.getRepositoryById;

const devStatusColors = {
  concept: "lichtblauw",
  development: "donkerblauw",
  beta: "donkergeel",
  stable: "groen",
  obsolete: "rood",
  archived: "coolgrey",
  unknown: "coolgrey",
};

// Failed findings first, most severe first; passed findings last
const severityOrder = { ERROR: 0, WARNING: 1, HINT: 2 };

const client = createClient<paths>({
  baseUrl: `${API_URL}/${API_ENDPOINT}/${API_VERSION}`,
});
const {
  data,
  error,
  response: { status, statusText, headers },
} = await client.GET(API_RESOURCE, {
  params: {
    path: { id },
  },
  headers: {
    "x-api-key": API_X_API_KEY,
  },
});

// Localization
const { i18n: i18nApp } = appConfig;
const i18nPage = {
  "pages.aside-landmark": "Contactinformatie",
};
i18n.addResourceBundle(
  i18n.language,
  "translation",
  i18nApp ? i18nApp[i18n.language] : {},
  true,
  true,
);
i18n.addResources(i18n.language, "translation", i18nPage);
const { t } = i18n;

const details = error ? null : data;

const getLang = (langKeys: Array<string>) =>
  langKeys.includes("nl") ? "nl" : langKeys[0] || "";
---

{ error && (
  <DonBasic appConfig={appConfig} titlePage="API niet gevonden">
    {/* biome-ignore lint/suspicious/noExplicitAny: error handling needs any at this moment */}
    <Alert type="error">{(error as unknown as any).message || (error as unknown as any).detail || `${status}: ${statusText}` || t('components.fuzz-error')}</Alert>
    <Paragraph>{t('components.item-not-found-error')}</Paragraph>
  </DonBasic>
)}

{details && (
  <DonDetail appConfig={appConfig} titlePage={details?.name} description={details.shortDescription}>
    <PiwikPro slot="head" client:only="react" 
      accountAddress={PIWIK_PRO_ACCOUNT_ADDRESS} 
      siteId={PIWIK_PRO_SITE_ID} 
    />
    <HeadingGroup
      slot="header"
      title={`${t(`pages.details-of-item`)}: ${details?.name}`}
      level={2} 
      data-track-content
      data-content-name="Detail Page Header"
    >
      <div class="subtitle" slot="subTitle">
        <Paragraph data-content-piece="Organisation Name" itemScope={true} itemType="https://schema.org/Organization" itemID={details?.organisation?.uri} className={`styles.aboveLink styles.publisher`}>
          <span itemprop="name"><Link data-content-target="Organisation Link" className={`styles.orgLink`} href={new URL(`./?organisation=${details?.organisation?.uri}`, Astro.url).toString()}>
              {details?.organisation?.label}
          </Link></span>
        </Paragraph>
        <div class="header-meta">
          <RepoIcon url={details.url || ''} name={details.name} className="moveAbove"></RepoIcon>
        </div>
      </div>
    </HeadingGroup>
    { /* biome-ignore lint/complexity/noUselessFragments: needed for slot */ }
    <Fragment slot="description">
      <Heading level={3} className="sr-only">{t(`pages.description`)}</Heading>
      <div class="utrecht-html"><Markdown text={details.longDescription} minHeadingDepth={4} /></div>
      <AlignBox align="top-left" wrap gap="small" className="features">{
        details.publicCode?.description ? details.publicCode?.description[getLang(Object.keys(details.publicCode?.description))]?.features?.map((feature) => (
          <span class="feature-pill">{feature}</span>
        )) : null
      }</AlignBox>
    </Fragment>
    { /* biome-ignore lint/complexity/noUselessFragments: needed for slot */ }
    <Fragment slot="aside">
      <DataSummary appearance="row">
        <DataSummaryItem itemKey="Organisatie" itemValue={details?.organisation?.label || '-'} />
        {/* <DataSummaryItem itemKey="Contactpersoon" itemValue={details?.contact?.name || '-'} />
        <DataSummaryItem itemKey="Email" itemValue={details?.contact?.email || '-'} /> */}
      </DataSummary>
      <Heading level={4}>{t(`pages.tbd-metadata`)}</Heading>
      <Block appearance="outlined">
        <DataSummary appearance="column" contained>
          <DataSummaryItem itemKey={t(`components.created-at`)} itemValue={new Date(details.createdAt as string | number).toLocaleDateString('nl-NL')} />
          <DataSummaryItem itemKey={t(`components.last-activity-at`)} itemValue={new Date(details.lastActivityAt as string | number).toLocaleDateString('nl-NL')} />
          <DataSummaryItem itemKey={t(`components.last-crawled-at`)} itemValue={new Date(details.lastCrawledAt as string | number).toLocaleDateString('nl-NL')} />
        </DataSummary>
      </Block>
    </Fragment>
    { /* biome-ignore lint/complexity/noUselessFragments: needed for slot */ }
    <Fragment slot="meta">
      <Block layout="flex-row">
        <Link href={details?.publicCodeUrl || 'https://yml.publiccode.tools/index.html'}><PillBadge startValue={`publiccode.yml`} endValue={details.publicCodeUrl ? details.publicCode?.publiccodeYmlVersion : "NA"} type="color" color={details.publicCodeUrl ? "mintgroen" : "grijs"} /></Link>
        <div>{t(`components.license`, {license: details.publicCode?.legal?.license || 'Onbekend'})}</div>
        <PillBadge startValue={`Status`} endValue={details.publicCode?.developmentStatus || "Onbekend"} type="color" color={devStatusColors[details.archived ? "archived" : details.publicCode?.developmentStatus || "unknown"]} />
      </Block>
      {details.archived ? <Alert type="warning">{t("pages.repository-archived-warning")}</Alert> : null}
      <Heading level={4}>{t(`pages.details`)}</Heading>
      <Block appearance="outlined">
        <Heading level={5}>{t(`pages.links`)}</Heading>
        <DataSummary appearance="column" contained>
          <DataSummaryItem itemKey={t(`pages.repository-url`)} itemValue={["TECHNICAL_FORK" , "VARIANT_FORK" , "GIT_FORK"].includes(details.forkType) ? t(`pages.fork-warning`, {context: details.forkType}) : ""} href={details.url}>{details.url}</DataSummaryItem>
          { 
            details.publicCode ? (
              <DataSummaryItem itemKey={t(`pages.public-code-url`)} itemValue={["URL_MISTAKE"].includes(details.forkType) ? t(`pages.possible-fork-warning`) : ""} href={details.publicCode?.url}>{details.publicCode?.url}</DataSummaryItem>
            ) : null
          }
        </DataSummary>
        <Heading level={5}>{t(`pages.platform-software`)}</Heading>
          { 
            details.publicCode ? (
        <DataSummary appearance="row" contained>
          <DataSummaryItem itemKey={t(`pages.platforms`)} itemValue={details.publicCode?.platforms?.join(" – ")} href={`https://yml.publiccode.tools/schema.core.html#key-platforms`}><Icon name="info" width="1.5rem" height="1.5rem" /></DataSummaryItem>
          <DataSummaryItem itemKey={t(`pages.software-type`)} itemValue={details.publicCode?.softwareType} href={`https://yml.publiccode.tools/schema.core.html#key-softwaretype`}><Icon name="info" width="1.5rem" height="1.5rem" /></DataSummaryItem>
          <DataSummaryItem itemKey={t(`pages.localisation`)} itemValue={`${details.publicCode?.localisation?.localisationReady ? "✔" : "✘"} — ${details.publicCode?.localisation?.availableLanguages?.join(" – ") || ""}`} href={`https://yml.publiccode.tools/schema.core.html#section-localisation`}><Icon name="info" width="1.5rem" height="1.5rem" /></DataSummaryItem>
          <DataSummaryItem itemKey={t(`pages.maintenance-type`)} itemValue={details.publicCode?.maintenance?.type} href={`https://yml.publiccode.tools/schema.core.html#key-maintenance-type`}><Icon name="info" width="1.5rem" height="1.5rem" /></DataSummaryItem>
        </DataSummary>
            ) : (
              <Alert type="info" className="publiccode-info utrecht-html"><Markdown text={t(`pages.create-a-public-code`)} /></Alert>
            )
          }
      </Block>
      <Heading level={4}>{t(`pages.repository-scan`)}</Heading>
      <AlignBox align="stretch" gap="medium" className="scans">
        <Block layout="flex-col" className="scan">
          <Heading level={5} className="">{t(`components.scan`)}</Heading>
          <p class="content">
            <DataBadge appearance="outlined" className={details.scan?.status}>
              {t(`components.status`, {context: details.scan?.status})}
              {details.scan?.status === "completed" ? <>&nbsp;<Icon aria-hidden name="active" /></> : null}
            </DataBadge><br />
            <span class="summary">{new Date(details.scan?.scannedAt ?? "").toLocaleString("nl-NL", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" })} UTC</span>
          </p>
          {details.scan?.status !== "failed" ? <PillBadge startValue={t(`components.score`)} endValue={details.scan?.repoScorePercentage} type="percentage"/> : null }
        </Block>
        {details.scan?.status !== "failed" ?
          <Block>
            <Heading level={5} className="title">{t(`components.checks`)}</Heading>
            <p class="content">
              <strong class="highlight">{(details.scan?.findingCounts.error ?? 0) + (details.scan?.findingCounts.warning ?? 0)}</strong>
              &nbsp;/&nbsp;
              <span>{details.scan?.findings.length}</span>
            </p>
            <ul class="content summary">
              <li>{(details.scan?.findingCounts.error ?? 0)} errors</li>
              <li>{(details.scan?.findingCounts.warning ?? 0)} warnings</li>
              <li>{(details.scan?.findingCounts.hint ?? 0)} hints</li>
            </ul>
          </Block>
          <Block>
            <Heading level={5} className="title">{t(`components.packages`)}</Heading>
            <p class="content">
              <strong class="highlight">{new Intl.NumberFormat("nl-NL").format(details.scan?.packageCount ?? 0)}</strong><br />
              <span class="summary">
                {(details.scan?.directDependencyCount ?? 0)} direct &middot;&nbsp;
                {(details.scan?.transitiveDependencyCount ?? 0)} transitive
              </span>
            </p>
          </Block>
          <Block>
            <Heading level={5} className="title">{t(`components.package-managers`)}</Heading>
            <p class="content">
              <strong class="highlight">{new Intl.NumberFormat("nl-NL").format(details.scan?.projects?.length ?? 0)}</strong>
              <small>{t('components.definition-files')}</small><br />
              <AlignBox align="top-left" wrap gap="small" className="features">
              {
                details.scan?.packageManagers?.map((packageManager) => (
                  <span class="feature-pill">{packageManager}</span>
                ))
              }
              </AlignBox>
            </p>
          </Block> : 
          <Block>
            <Alert type="warning">
              <Heading level={5} className="error-title">
                {
                  details.scan?.failedStage ? 
                    <><small>Failed in stage </small>{details.scan?.failedStage}</> : 
                    null
                }
              </Heading>
              <Paragraph>
                {details.scan?.error}
              </Paragraph>
            </Alert>
          </Block> 
        }
      </AlignBox>
      {details.scan?.status !== "failed" ? 
        <>
          <Heading level={5} className="findings-title">
            <span>{t(`components.checks`)}</span>
          </Heading>
          <DataList appearance="rows" className="findings">
            {
              [...(details.scan?.findings ?? [])]
                .sort(
                  (a, b) =>
                    Number(a.passed) - Number(b.passed) ||
                    severityOrder[a.severity] - severityOrder[b.severity],
                )
                .map((finding) => (
                <>
                  <DataListItem>
                    <DataListKey className="title">
                      {t(`scans.${finding.rule}`, {context: finding.passed ? 'passed' : ''})}
                      {
                        finding.passed ? 
                        <Icon name="active" className="passed" /> :
                        <DataBadge appearance={finding.severity.toLowerCase() as DataBadgeAppearance}>{t(`scans.severity.${finding.severity}`)}</DataBadge>
                      }
                    </DataListKey>
                    <DataListValue>
                      <AlignBox align="top-left" direction="column" gap="small">
                        <div class="message">{finding.message}</div>
                        <div class="rule">{finding.rule}</div>
                      </AlignBox>
                    </DataListValue>
                    <DataListActions>
                      {
                        finding.passed ? 
                        <ButtonLink appearance="subtle-button" href={finding.howToFixUrl} className="fixurl">{t(`components.howto`)}<Icon name="externe-link-inline" /></ButtonLink> :                   
                        <ButtonAction appearance="inline-button" iconEnd="externe-link-inline">{t(`components.howto`)}</ButtonAction>
                      }
                    </DataListActions>
                  </DataListItem>
                </>
              ))
            }
          </DataList>
          <Heading level={5} className="projects-title">
            <span>{t(`components.packages`)}</span>
            <small>{t('components.definition-files', {count: details.scan?.projects?.length})}</small>
          </Heading>
          <ProjectsAccordion client:visible projects={details.scan?.projects} />
        </> : 
        null 
      }
    </Fragment>
  </DonDetail>
  )
}

<style>
  .subtitle {
    display: flex;
    justify-content: space-between;
  }

  .header-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 1rem;
  }

  .features {
    margin-top: 0.5rem;
    font-size: smaller;
  }
  
  .feature-pill {
    display: inline-block;
    padding-block: 2px;
    padding-inline: 6px;
    background-color: var(--rhc-color-cool-grey-200);
    border-radius: 2px;
  }

  .publiccode-info {
    --utrecht-code-background-color: rgb(from var(--rhc-color-cool-grey-50) r g b / 0.5);
    code {
      padding-inline: 2px;
    }
  }

  .scans {
    justify-content: space-between;

    & > * {
      flex-basis: 25%;
      flex-grow: 1;
    }

    .error-title {
      small {
        font-weight: normal;
      }
    }

    .scan {
      gap: 0.5rem;
      justify-content: flex-start;

      .incomplete {
        --utrecht-data-badge-color: var(--rhc-color-border-default);
      }

      .failed {
        /* outline: 1mm dashed salmon; */
        --utrecht-data-badge-color: var(--rhc-color-negative-500);
      }
    }
    .title {
      margin-block-end: 0.5rem;
    }
    .content {
      margin: 0;
    }
    ul.content {
      padding-inline: 1rem;
      line-height: normal;
    }

    .highlight {
      font-size: xx-large;
    }

    .summary {
      color: var(--rhc-color-cool-grey-700);
      font-size: smaller;
    }
  }

  .findings {
    margin-block-end: 1rem;
    .title {
      display: flex;
      gap: 0.5rem;
    }

    .passed {
      color: var(--rhc-color-positive-500);
      block-size: 1.25rem;
      inline-size: 1.25rem;
    }

    .rule {
      color: var(--rhc-color-cool-grey-700);
    }

    .fixurl {
      font-weight: normal;
      min-inline-size: auto;
      min-block-size: auto;
      padding-block-start: 0.25rem;
      padding-block-end: 0.25rem;
      padding-inline-start: 0.5rem;
      padding-inline-end: 0.5rem;
    }
  }

  .findings-title,
  .projects-title {
    display: flex;
    justify-content: space-between;

    small {
      font-weight: normal;
    }
  }

</style>
