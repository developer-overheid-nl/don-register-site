---
import i18n from "@developer-overheid-nl/don-register-components/i18n";
import appConfig from "../../app.config";
import { getRepoProvider } from "./repoProviders";

interface Props {
  type?: string;
  url: string;
  name?: string;
  className?: string;
}
const { type, url, name, className } = Astro.props;

const { i18n: i18nApp } = appConfig;
i18n.addResourceBundle(
  i18n.language,
  "translation",
  i18nApp ? i18nApp[i18n.language] : {},
  true,
  true,
);
const { t } = i18n;

const provider = getRepoProvider(url, type);
---

{provider && (
  <a href={url} target="_blank" rel="noopener noreferrer" class={`repo-link ${className}`} aria-label={t('components.goto-name-on-site', {name: name, site: provider.name})}>
    <img class={`repo-logo ${provider.key}-logo`} src={provider.logo} alt={provider.alt} width="24" height="24" />
  </a>
)}

<style>
  .repo-link {
    position: relative;
    display: inline-block;
    place-content: center;
    &:hover::after {
      position: absolute;
      top: -0.5rem;
      right: -0.5rem;
      bottom: -0.5rem;
      left: -0.5rem;
      z-index: -1;
      content: '';
      background-color: rgba(0, 0, 0, 0.1);
      border-radius: 50%;
    }
  }

  .repo-logo {
    display: block;
    width: 24px;
    height: 24px;
  }

  .gitlab-logo {
    object-fit: cover;
    object-view-box: inset(28% 28% 28% 28%);
  }

  .bitbucket-logo {
    object-fit: cover;
    object-view-box: inset(14% 14% 14% 14%);
  }
</style>
