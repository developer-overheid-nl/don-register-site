---
export const prerender = false; // Not needed in 'server' mode

import {
  API_ENDPOINT,
  API_URL,
  API_VERSION,
  API_X_API_KEY,
  PIWIK_PRO_ACCOUNT_ADDRESS,
  PIWIK_PRO_SITE_ID,
} from "astro:env/server";
import {
  Alert,
  AlignBox,
  Block,
  CopyButton,
  DataBadgeLink,
  DataSummary,
  DataSummaryItem,
  Heading,
  HeadingGroup,
  Link,
  Markdown,
  Paragraph,
  PillBadge,
  ReadOnlyTextInput,
} from "@developer-overheid-nl/don-register-components";
import { PiwikPro } from "@developer-overheid-nl/don-register-components/analytics";
import i18n from "@developer-overheid-nl/don-register-components/i18n";
import {
  DonBasic,
  DonDetail,
} from "@developer-overheid-nl/don-register-layouts";
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHeader,
  TableHeaderCell,
  TableRow,
} from "@rijkshuisstijl-community/components-react";
import { t } from "i18next";
import createClient from "openapi-fetch";
import appConfig from "../../../app.config";
import DependenciesAccordion from "../../components/DependenciesAccordion";
import { createSchemaDocumentation } from "../../helpers/schemaDocumentation";
import {
  createDependencyPresentation,
  createHealthIssuesTable,
} from "../../helpers/schemaPresentation";
import { ApiPaths, type paths } from "../../types/api-schema";

const { id = "" } = Astro.params;
const API_RESOURCE = ApiPaths.getSchemaById;

const client = createClient<paths>({
  baseUrl: `${API_URL}/${API_ENDPOINT}/${API_VERSION}`,
});
const {
  data,
  error,
  response: { status, statusText, headers },
} = await client.GET(API_RESOURCE, {
  params: {
    path: { id },
  },
  headers: {
    "x-api-key": API_X_API_KEY,
  },
});

// Localization
const { i18n: i18nApp } = appConfig;
const i18nPage = {
  "pages.aside-landmark": "Schema-informatie",
};
i18n.addResourceBundle(
  i18n.language,
  "translation",
  i18nApp ? i18nApp[i18n.language] : {},
  true,
  true,
);
i18n.addResources(i18n.language, "translation", i18nPage);

const details = error ? null : data;

const rawSchemaUrl = details?.schemaUrl || "";
const prettySchema = details?.content
  ? JSON.stringify(details.content, null, 2)
  : null;
const schemaDocumentation = createSchemaDocumentation(details?.content);
const sourceMetaDependencyDetails = details?.sourceMetaDependencyDetails ?? [];
const sourceMetaHealthIssues = details?.sourceMetaHealthIssues ?? [];
const healthIssuesTable = createHealthIssuesTable(sourceMetaHealthIssues);
const canonicalSchemaUrl =
  details?.content && typeof details.content.$id === "string"
    ? details.content.$id
    : undefined;
const dependencyPresentation = createDependencyPresentation(
  sourceMetaDependencyDetails,
  {
    id,
    schemaUrl: details?.schemaUrl,
    canonicalUrl: canonicalSchemaUrl,
  },
);
const dependencyGroups = [
  {
    title: "Gebruikt door dit schema",
    emptyMessage: "Dit schema gebruikt geen andere schema's.",
    rows: dependencyPresentation.outgoing,
  },
  {
    title: "Dit schema wordt gebruikt door",
    emptyMessage: "Dit schema wordt niet door andere schema's gebruikt.",
    rows: dependencyPresentation.incoming,
  },
];
const formatValue = (value: string | number | null | undefined) =>
  value === null || value === undefined || value === "" ? "-" : String(value);
const formatDate = (value: string | number | null | undefined) =>
  value ? new Date(value).toLocaleDateString("nl-NL") : "-";
const formatNumber = (value: number | null | undefined) =>
  value === null || value === undefined
    ? "-"
    : new Intl.NumberFormat("nl-NL").format(value);
const formatPercentage = (value: number | null | undefined) =>
  value === null || value === undefined ? undefined : String(value);
const getAbsoluteSchemaUrl = (schemaUrl: string | undefined) => {
  if (!schemaUrl) {
    return undefined;
  }

  try {
    return new URL(schemaUrl, Astro.url.origin).toString();
  } catch {
    return undefined;
  }
};
---

{ error && (
  <DonBasic appConfig={appConfig} titlePage="Schema niet gevonden">
    <Alert type="error">{(error as unknown as any).message || (error as unknown as any).detail || `${status}: ${statusText}` || t('components.fuzz-error')}</Alert>
    <Paragraph>{t('components.item-not-found-error')}</Paragraph>
  </DonBasic>
)}

{details && (
  <DonDetail appConfig={appConfig} titlePage={details?.title}>
    <PiwikPro slot="head" client:only="react"
      accountAddress={PIWIK_PRO_ACCOUNT_ADDRESS}
      siteId={PIWIK_PRO_SITE_ID}
    />
    <HeadingGroup
      slot="header"
      title={`${t(`pages.details-of-item`)}: ${details?.title}`}
      level={2}
      data-track-content
      data-content-name="Detail Page Header"
    >
    </HeadingGroup>
    <Fragment slot="description">
      <Heading level={3} className="sr-only">{t(`pages.description`)}</Heading>
      <div class="utrecht-html"><Markdown text={details.description} minHeadingDepth={4} /></div>
    </Fragment>
    <Fragment slot="aside">
      <DataSummary appearance="row">
        <DataSummaryItem itemKey={t(`components.created-at`)} itemValue={formatDate(details.createdAt)} />
        <DataSummaryItem itemKey="Base dialect" itemValue={formatValue(details.sourceMetaBaseDialect)} />
        <DataSummaryItem itemKey="SourceMeta dialect" itemValue={formatValue(details.sourceMetaDialect)} />
        <DataSummaryItem itemKey="Health" itemValue={details.sourceMetaHealth === undefined ? "-" : `${formatNumber(details.sourceMetaHealth)}%`} />
        <DataSummaryItem itemKey="Dependencies" itemValue={formatNumber(details.sourceMetaDependencies)} />
      </DataSummary>
    </Fragment>
    <Fragment slot="meta">
      <Block layout="flex-row">
        <PillBadge startValue="Dialect" endValue={details.dialect || "unknown"} type="color" color={details.dialect && details.dialect !== "unknown" ? "mintgroen" : "grijs"} />
        <PillBadge startValue="Type" endValue={details.rootType || "unknown"} type="color" color={details.rootType && details.rootType !== "unknown" ? "lichtblauw" : "grijs"} />
        { formatPercentage(details.sourceMetaHealth) !== undefined && (
          <PillBadge startValue="Health" endValue={formatPercentage(details.sourceMetaHealth)} type="percentage" />
        )}
        { details.sourceMetaDependencies !== undefined && (
          <PillBadge startValue="Dependencies" endValue={formatNumber(details.sourceMetaDependencies)} type="color" color="coolgrey" />
        )}
      </Block>

      { schemaDocumentation && (
        <Fragment>
          <Heading level={4}>Schema documentatie</Heading>
          <Block appearance="outlined" className="schema-documentation-block" data-track-content data-content-name="Schema Documentation">
            <Table className="schema-documentation-table">
              <TableCaption className="sr-only">Documentatie van het JSON Schema</TableCaption>
              <colgroup>
                <col class="schema-property-column" />
                <col class="schema-type-column" />
                <col class="schema-required-column" />
                <col />
              </colgroup>
              <TableHeader>
                <TableRow>
                  <TableHeaderCell scope="col">Eigenschap</TableHeaderCell>
                  <TableHeaderCell scope="col">Type</TableHeaderCell>
                  <TableHeaderCell scope="col">Verplicht</TableHeaderCell>
                  <TableHeaderCell scope="col">Beschrijving en details</TableHeaderCell>
                </TableRow>
              </TableHeader>
              <TableBody>
                { schemaDocumentation.tableRows.map((row) => (
                  <TableRow className={row.isRoot ? "schema-documentation-root" : undefined}>
                    <TableHeaderCell scope="row">
                      <span class="schema-property" style={`--schema-depth: ${row.depth}`}>
                        {row.property}
                      </span>
                    </TableHeaderCell>
                    <TableCell><code>{row.type}</code></TableCell>
                    <TableCell>{row.required}</TableCell>
                    <TableCell className="schema-description">
                      <div>{row.description}</div>
                      { row.details.length > 0 && (
                        <ul class="schema-details">
                          { row.details.map((item) => (
                            <li>
                              <strong>{item.key}:</strong>{" "}
                              { item.href ? (
                                <Link href={item.href}>{item.value}</Link>
                              ) : (
                                item.value
                              )}
                            </li>
                          ))}
                        </ul>
                      )}
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </Block>
        </Fragment>
      )}

      { prettySchema && (
        <Fragment>
          <Heading level={4}>JSON Schema</Heading>
          <Block appearance="outlined" className="schema-content">
            <pre class="schema-pre"><code>{prettySchema}</code></pre>
          </Block>
        </Fragment>
      )}

      <Heading level={3}>Schema gebruiken</Heading>
      <Block appearance="outlined" layout="flex-col" data-track-content data-content-name="Detail Page Schema Tools">
        <AlignBox data-content-piece="JSON Schema" align="space-between" gap="small">
          <label for="schemaUrl" class="no-shrink">JSON Schema</label>
          <ReadOnlyTextInput
            id="schemaUrl"
            type="url"
            aria-label="JSON Schema URL"
            defaultValue={rawSchemaUrl}
            name="schemaUrl"
            fontVariant="monospace"
          />
          <CopyButton client:load text={rawSchemaUrl} data-content-target="Schema Copy Button" />
        </AlignBox>
        {/* biome-ignore lint/a11y/useSemanticElements: ol/ul not possible */}
        <div class="utrecht-badge-list" role="list" data-content-piece="Schema links">
          { details.schemaUrl && (
            <DataBadgeLink data-content-target="Open schema.json" href={details.schemaUrl} target="_blank" rel="noopener" role="listitem">
              schema.json
            </DataBadgeLink>
          )}
          { details.sourceMetaBundledUrl && (
            <DataBadgeLink data-content-target="Download bundled schema" href={details.sourceMetaBundledUrl} role="listitem">
              Download bundled
            </DataBadgeLink>
          )}
        </div>
      </Block>

      <Heading level={4}>Dependencies</Heading>
      <Block appearance="outlined" layout="flex-col" className="dependencies-block">
        <DependenciesAccordion
          client:load
          groups={dependencyGroups.map((group) => ({
            ...group,
            rows: group.rows.map((dependency) => ({
              at: dependency.at,
              href: getAbsoluteSchemaUrl(dependency.schemaUrl),
              schemaLabel: dependency.schemaLabel,
            })),
          }))}
        />
      </Block>

      <Heading level={4}>Health issues</Heading>
      <Block appearance="outlined" className="health-issues-block">
        { healthIssuesTable.rows.length > 0 ? (
          <Table className="health-issues-table">
            <TableCaption className="sr-only">Health issues</TableCaption>
            <TableHeader>
              <TableRow>
                <TableHeaderCell scope="col">Message</TableHeaderCell>
                { healthIssuesTable.showPointerColumn && <TableHeaderCell scope="col">Pointer</TableHeaderCell> }
              </TableRow>
            </TableHeader>
            <TableBody>
              { healthIssuesTable.rows.map((issue) => (
                <TableRow>
                  <TableCell>{issue.message}</TableCell>
                  { healthIssuesTable.showPointerColumn && (
                    <TableCell>{issue.pointer && <code>{issue.pointer}</code>}</TableCell>
                  )}
                </TableRow>
              ))}
            </TableBody>
          </Table>
        ) : (
          <Paragraph>Geen health issues gevonden.</Paragraph>
        )}
      </Block>

    </Fragment>
  </DonDetail>
  )
}

<style>
  .schema-content {
    overflow-x: auto;
  }

  .schema-pre {
    margin: 0;
    padding: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    background-color: rgb(from var(--rhc-color-cool-grey-50) r g b / 0.5);
    overflow-x: auto;
  }

  .health-issues-block {
    overflow-x: auto;
  }

  .schema-documentation-block {
    overflow-x: auto;
  }

  .dependencies-block {
    align-items: stretch;
  }

  :global(.schema-documentation-table code),
  :global(.dependency-table code),
  :global(.health-issues-table code) {
    overflow-wrap: anywhere;
  }

  :global(.health-issues-table .utrecht-table__header-cell:first-child) {
    width: 65%;
  }

  :global(.schema-documentation-table) {
    min-width: 48rem;
  }

  :global(.schema-property-column) {
    width: 23%;
  }

  :global(.schema-type-column) {
    width: 13%;
  }

  :global(.schema-required-column) {
    width: 12%;
  }

  :global(.schema-property) {
    display: block;
    padding-inline-start: calc(var(--schema-depth) * 1rem);
    font-family: monospace;
    overflow-wrap: anywhere;
  }

  :global(.schema-documentation-root) {
    background-color: rgb(from var(--rhc-color-cool-grey-50) r g b / 0.5);
  }

  :global(.schema-documentation-root .schema-property) {
    font-family: inherit;
  }

  :global(.schema-description) {
    min-width: 18rem;
  }

  :global(.schema-details) {
    display: grid;
    gap: 0.25rem;
    margin-block: 0.5rem 0;
    padding-inline-start: 0;
    font-size: 0.875rem;
    list-style: none;
  }

  :global(.dependencies-accordion) {
    width: 100%;
  }

  :global(.dependency-table-wrapper) {
    overflow-x: auto;
  }

  :global(.dependency-table) {
    min-width: 36rem;
  }

  :global(.dependency-table .utrecht-table__header-cell:first-child) {
    width: 42%;
  }

  :global(.dependency-table .utrecht-table__body .utrecht-table__header-cell) {
    overflow-wrap: anywhere;
  }
</style>
